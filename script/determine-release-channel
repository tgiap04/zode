#!/usr/bin/env bash

set -euo pipefail

if [ -z "${GITHUB_ACTIONS-}" ]; then
    echo "Error: This script must be run in a GitHub Actions environment"
    exit 1
elif [ -z "${GITHUB_REF_NAME-}" ]; then
    # This should be the release tag 'v0.x.x'
    echo "Error: GITHUB_REF_NAME is not set"
    exit 1
fi

# The channel is read off the shape of the tag rather than crates/zed/RELEASE_CHANNEL,
# and the tag is not required to match the version in Cargo.toml. Upstream ties the two
# together and rejects anything outside stable/preview, which makes every release a
# version-bump commit first; this fork releases straight from a tag.
#
#   v0.1.0        -> stable,  not a prerelease
#   v0.1.0-beta.1 -> preview, prerelease
version="${GITHUB_REF_NAME#v}"

if [ "$version" = "$GITHUB_REF_NAME" ]; then
    echo "Error: release tag ${GITHUB_REF_NAME} must start with 'v'"
    exit 1
fi

if [[ "$version" == *-* ]]; then
    channel="preview"
else
    channel="stable"
fi

echo "Publishing version: ${version} on release channel ${channel}"
echo "RELEASE_CHANNEL=${channel}" >> "$GITHUB_ENV"
echo "RELEASE_VERSION=${version}" >> "$GITHUB_ENV"

# The bundling scripts read the FILE, not this env var -- it is what picks the
# `[package.metadata.bundle-*]` section on macOS, `APP_NAME` on Linux and the
# installer's whole naming block on Windows. Leaving it at the checked-in value
# is how a tagged release ends up installing itself as a dev build.
echo "${channel}" > crates/zed/RELEASE_CHANNEL
